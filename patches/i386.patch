index 20b50c84..c48b9a19 100644
--- a/src/devices/cpu/i386/i386.cpp
+++ b/src/devices/cpu/i386/i386.cpp
@@ -2071,7 +2071,10 @@ void i386_device::device_start()
 {
 	i386_common_init();
 
-	build_opcode_table(OP_I386);
+	// a 387 is fitted: the escape opcodes have to be decoded and the x87
+	// dispatch table built, or the first one of them goes through a null
+	build_opcode_table(OP_I386 | OP_FPU);
+	build_x87_opcode_table();
 	m_cycle_table_rm = cycle_table_rm[CPU_CYCLES_I386].get();
 	m_cycle_table_pm = cycle_table_pm[CPU_CYCLES_I386].get();
 
@@ -2553,6 +2556,8 @@ void i386_device::device_reset()
 
 	m_auto_clear_RF = true;
 
+	x87_reset();
+
 	CHANGE_PC(m_eip);
 }
 
